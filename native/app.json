{
  "expo": {
    "name": "SelfShop",
    "slug": "selfshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/reseller_app_logo.jpeg",
    "scheme": "selfshop",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selfshop.reseller"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E5005F",
        "foregroundImage": "./assets/images/reseller_app_logo.jpeg"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.selfshop.reseller"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/reseller_app_logo.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/reseller_app_logo.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E5005F",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow SelfShop to access your photos to save product images.",
          "savePhotosPermission": "Allow SelfShop to save product images to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55e5a403-6d5d-4cb9-b2f0-5e955e7bd50d"
      }
    },
    "owner": "shorno"
  }
}
