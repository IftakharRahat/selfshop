{
  "expo": {
    "name": "SelfShop Supplier",
    "slug": "selfshop-supplier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/supplier_app_logo.png",
    "scheme": "selfshop-supplier",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selfshop.supplier"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2d2a5d",
        "foregroundImage": "./assets/images/supplier_app_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.selfshop.supplier"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/supplier_app_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/supplier_app_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2d2a5d",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
